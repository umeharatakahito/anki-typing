  { no: 60, ko: "きこゆ", pos: "動", page: 80, ja: "聞こえる・世間に知られる・理解できる・申し上げる", ex: "夜更けて、山寺の鐘の音かすかに〔きこゆ〕。", exja: "夜がふけて、山寺の鐘の音がかすかに【聞こえる】。", kana: "きこえる", nu: "謙譲語の意味もある" },
  { no: 61, ko: "おこす", pos: "動", page: 80, ja: "よこす", ex: "都なる友、めづらしき花を添へて文を〔おこし〕たり。", exja: "都にいる友人が、珍しい花を添えて手紙を【よこし】た。", kana: "よこし", nu: "「起こす」ではない" },
  { no: 62, ko: "まうく", pos: "動", page: 81, ja: "準備する", ex: "今宵の客のために、酒と肴を〔まうけ〕たり。", exja: "今夜の客のために、酒と肴を【準備し】た。", kana: "じゅんびし", nu: "「儲く」と同音で紛らわしい" },
  { no: 63, ko: "いらふ", pos: "動", page: 82, ja: "答える", ex: "いかにと問へど、童は何とも〔いらへ〕ず。", exja: "どうしたのかと尋ねたが、子どもは何とも【答え】ない。", kana: "こたえ" },
  { no: 64, ko: "わたる", pos: "動", page: 82, ja: "渡る・移動する・ずっと〜する", ex: "夜明けに舟に乗りて、向かひの岸へ〔わたり〕けり。", exja: "夜明けに舟に乗って、向こう岸へ【渡り】ました。", kana: "わたり" },
  { no: 65, ko: "ぐす", kanji: "具す", pos: "動", page: 83, ja: "（引き）連れる・つき従う・添える", ex: "大納言、幼き童を〔ぐし〕て、深き山に入りけり。", exja: "大納言は、幼い子どもを【連れ】て、深い山に入った。", kana: "つれ" },
  { no: 66, ko: "とぶらふ", pos: "動", page: 84, ja: "訪れる・見舞う・弔問する", ex: "久しく病める友を〔とぶらひ〕に、山里へまかる。", exja: "長く病気である友人を【見舞い】に、山里へ行く。", kana: "みまい" },
  { no: 67, ko: "ものす", pos: "動", page: 85, ja: "いる・行く・来る", ex: "父はただ今、奥の間に〔ものす〕とぞ聞く。", exja: "父はちょうど今、奥の部屋に【いる】と聞いている。", kana: "いる", nu: "動詞の代用語（する・言う等）" },
  { no: 68, ko: "わななく", pos: "動", page: 86, ja: "ふるえる", ex: "夜の寒さに、手も足もいたく〔わななき〕けり。", exja: "夜の寒さのために、手も足もひどく【ふるえ】た。", kana: "ふるえ" },
  { no: 69, ko: "わづらふ", pos: "動", page: 86, ja: "思い悩む・病気になる・苦労する", ex: "行く末のことを〔わづらひ〕て、夜もえ寝ず。", exja: "将来のことを【思い悩ん】で、夜も眠ることができない。", kana: "おもいなやん", nu: "「〜わづらふ」で~しかねる意" },
  { no: 70, ko: "まどふ", pos: "動", page: 87, ja: "心が乱れる・途方に暮れる", ex: "道を失ひて、深き山の中に〔まどひ〕ぬ。", exja: "道がわからなくなって、深い山の中で【途方に暮れ】た。", kana: "とほうにくれ", nu: "「〜まどふ」でひどく〜する意" },
  { no: 71, ko: "かづく", kanji: "被く", pos: "動", page: 88, ja: "（ほうびを）いただく・（ほうびを）与える", ex: "舞のいみじう上手なれば、主より衣を〔かづき〕けり。", exja: "舞がたいそう上手なので、主人から褒美の着物を【いただい】た。", kana: "いただい", nu: "四段=もらう、下二段=与える" },
  { no: 72, ko: "うす", kanji: "失す", pos: "動", page: 88, ja: "消える・亡くなる", ex: "朝霧のうちに、沖ゆく舟の影も〔うせ〕にけり。", exja: "朝霧の中に、沖を行く舟の姿も【消え】てしまった。", kana: "きえ", nu: "「亡くなる」の婉曲表現" },
  { no: 73, ko: "おこなふ", pos: "動", page: 89, ja: "仏道の修行をする・勤行する", ex: "聖は夜もすがら、仏の御前にて〔おこなひ〕けり。", exja: "僧は一晩中、仏の前で【修行し】た。", kana: "しゅぎょうし", nu: "多くは仏道修行の意で使う" },
  { no: 74, ko: "おもしろし", pos: "形", page: 92, ja: "（景色などが）すばらしい・興趣がある", ex: "月の光に濡るる庭の池、いと〔おもしろし〕。", exja: "月の光に濡れている庭の池は、たいそう【趣がある】。", kana: "おもむきがある" },
  { no: 75, ko: "あらまほし", pos: "形", page: 92, ja: "理想的だ・望ましい", ex: "家のたたずまひも主の心ばへも〔あらまほし〕。", exja: "家のようすも主人の心づかいも【理想的だ】。", kana: "りそうてきだ" },
  { no: 76, ko: "やむごとなし", pos: "形", page: 93, ja: "高貴だ・この上ない", ex: "〔やむごとなき〕人の御むすめ、宮に参りたまふ。", exja: "【高貴な】人の娘が、宮中に参上なさる。", kana: "こうきな" },
  { no: 77, ko: "ゆゆし", pos: "形", page: 94, ja: "不吉だ・すばらしい・はなはだしい", ex: "かかる夢をたびたび見るは〔ゆゆし〕きことなり。", exja: "このような夢をたびたび見るのは【不吉な】ことだ。", kana: "ふきつな", nu: "良い意味にも悪い意味にも使う" },
  { no: 78, ko: "かしこし", pos: "形", page: 95, ja: "おそれ多い・すばらしい・賢い", ex: "帝の仰せをみづから承ること、いと〔かしこし〕。", exja: "帝のお言葉を自分で承ることは、たいそう【おそれ多い】。", kana: "おそれおおい" },
  { no: 79, ko: "うるはし", pos: "形", page: 96, ja: "端正だ・きちんとしている", ex: "灯のもとに見ゆる姫君の姿、いと〔うるはし〕。", exja: "灯火のもとに見える姫君の姿は、たいそう【端正だ】。", kana: "たんせいだ", nu: "対人関係では「よそよそしい」意も" },
  { no: 80, ko: "はかなし", pos: "形", page: 96, ja: "頼りない・むなしい・ちょっとした", ex: "草の露に似たる人の命は〔はかなき〕ものなり。", exja: "草の露に似ている人の命は【頼りない】ものだ。", kana: "たよりない" },
  { no: 81, ko: "はかばかし", pos: "形", page: 97, ja: "しっかりしている・はっきりしている", ex: "この子の言へることは、幼けれど〔はかばかし〕。", exja: "この子の言うことは、幼いけれども【しっかりしている】。", kana: "しっかりしている", nu: "多く打消で「順調でない」の意" },
  { no: 82, ko: "やさし", pos: "形", page: 98, ja: "優雅だ・けなげだ", ex: "散る花を惜しむ君が心ばへこそ〔やさしけれ〕。", exja: "散る花を惜しむあなたの心づかいこそ【優雅だ】。", kana: "ゆうがだ", nu: "現代語の「優しい」とは別の意" },
  { no: 83, ko: "いはけなし", pos: "形", page: 98, ja: "幼い", ex: "〔いはけなき〕子ども、庭にて日暮るるまで遊びけり。", exja: "【幼い】子どもが、庭で日が暮れるまで遊んでいた。", kana: "おさない" },
  { no: 84, ko: "かたはらいたし", pos: "形", page: 99, ja: "見苦しい・気の毒だ・恥ずかしい", ex: "人多かる所にて声高に騒ぐさま、いと〔かたはらいたし〕。", exja: "人が多い所で大声で騒ぐ様子は、たいそう【見苦しい】。", kana: "みぐるしい" },
  { no: 85, ko: "こころもとなし", pos: "形", page: 100, ja: "待ち遠しい・不安だ・はっきりしない", ex: "旅に出でし子の便り絶えて〔こころもとなし〕。", exja: "旅に出た子からの便りが絶えて【不安だ】。", kana: "ふあんだ" },
  { no: 86, ko: "いとほし", pos: "形", page: 101, ja: "かわいそうだ・かわいい", ex: "道に迷ひて泣く童を見て〔いとほし〕と思ひけり。", exja: "道に迷って泣いている子どもを見て【かわいそうだ】と思った。", kana: "かわいそうだ", nu: "後に「かわいい」の意に変化" },
  { no: 87, ko: "あさまし", pos: "形", page: 102, ja: "驚きあきれるほどだ・情けない", ex: "人の心のたやすく変はりゆくこと〔あさまし〕。", exja: "人の心が簡単に変わっていくことは【あきれるほどだ】。", kana: "あきれるほどだ", nu: "現代語より「驚き」の意が強い" },
  { no: 88, ko: "いたし", pos: "形", page: 103, ja: "はなはだしい・とても", ex: "秋の夜に聞く笛の音〔いたく〕おもしろかりけり。", exja: "秋の夜に聞く笛の音は【とても】趣深かった。", kana: "とても", nu: "「いみじ」(すばらしい)と混同注意" },
  { no: 89, ko: "つれなし", pos: "形", page: 104, ja: "平然としている・冷淡だ", ex: "いかに責めらるとも〔つれなく〕もてなしけり。", exja: "どんなに責められても【平然として】ふるまった。", kana: "へいぜんとして" },
  { no: 90, ko: "あいなし", pos: "形", page: 105, ja: "筋違いだ・つまらない・気にくわない", ex: "雨いたく降りて花見も〔あいなく〕なりにけり。", exja: "雨がひどく降って花見も【つまらなく】なってしまった。", kana: "つまらなく" },
  { no: 91, ko: "あぢきなし", pos: "形", page: 106, ja: "どうにもならない・つまらない", ex: "世の中の定めなきをのみ思へば〔あぢきなし〕。", exja: "世の中が定まらないことばかり思うと【どうにもならない】。", kana: "どうにもならない" },
  { no: 92, ko: "さがなし", pos: "形", page: 106, ja: "性質がよくない・いたずらだ", ex: "この家の童は〔さがなく〕て人の物を隠しけり。", exja: "この家の子どもは【いたずらで】人の物を隠した。", kana: "いたずらで", nu: "子どもには「腕白だ」の意も" },
  { no: 93, ko: "すさまじ", pos: "形", page: 107, ja: "興ざめだ・殺風景だ", ex: "花みな散りたる庭を見るもいと〔すさまじ〕。", exja: "花がすっかり散った庭を見るのもたいそう【興ざめだ】。", kana: "きょうざめだ", nu: "現代語「すごい」とは意味が違う" },
  { no: 94, ko: "いふかひなし", pos: "形", page: 108, ja: "どうしようもない・取るに足りない", ex: "今さら悔ゆとも〔いふかひなき〕ことなりけり。", exja: "今になって後悔しても【どうしようもない】ことであった。", kana: "どうしようもない" },
  { no: 95, ko: "よしなし", pos: "形", page: 109, ja: "関係がない・つまらない", ex: "我に〔よしなき〕事どもを問ひて人を煩はす。", exja: "私に【関係のない】事柄を尋ねて人を煩わせる。", kana: "かんけいのない" },
  { no: 96, ko: "びんなし", kanji: "便無し", pos: "形", page: 110, ja: "都合が悪い・困ったことだ", ex: "にはかに雨降りて〔びんなき〕ことになりぬ。", exja: "急に雨が降って【困った】ことになった。", kana: "こまった" },
  { no: 97, ko: "さうざうし", pos: "形", page: 110, ja: "物足りない・心寂しい", ex: "待つ友の来ねば今宵の宴も〔さうざうし〕。", exja: "待っている友が来ないので今夜の宴も【物足りない】。", kana: "ものたりない" },
  { no: 98, ko: "むつかし", pos: "形", page: 111, ja: "うっとうしい・わずらわしい", ex: "長雨降り続きて心も〔むつかしく〕おぼえけり。", exja: "長雨が降り続いて心も【うっとうしく】感じられた。", kana: "うっとうしく", nu: "現代語「難しい」とは意味が違う" },
  { no: 99, ko: "あてなり", pos: "形動", page: 114, ja: "身分が高い・上品だ", ex: "その姫君の姿かたちいと〔あてなり〕。", exja: "その姫君の姿かたちはたいそう【上品だ】。", kana: "じょうひんだ" },
  { no: 100, ko: "きよらなり", pos: "形動", page: 114, ja: "美しい・気高い", ex: "月の光〔きよらなる〕夜に人を待ちゐたり。", exja: "月の光が【美しい】夜に人を待っていた。", kana: "うつくしい", nu: "「きよげなり」より程度が上" },
  { no: 101, ko: "さらなり", pos: "形動", page: 115, ja: "（いまさら）言うまでもない・もちろんだ", ex: "雪降りたる朝の庭の美しきは〔さらなり〕。", exja: "雪が降った朝の庭が美しいのは【言うまでもない】。", kana: "いうまでもない" },
  { no: 102, ko: "あらはなり", pos: "形動", page: 116, ja: "まる見えだ・明らかだ", ex: "垣の崩れて庭の内まで〔あらはなり〕。", exja: "垣根が崩れて庭の中まで【まる見えだ】。", kana: "まるみえだ" },
  { no: 103, ko: "あからさまなり", pos: "形動", page: 116, ja: "ちょっとの間だ", ex: "〔あからさまに〕門を出でてやがて帰り来ぬ。", exja: "【ちょっとの間】門の外に出てすぐに帰って来た。", kana: "ちょっとのあいだ", nu: "現代語「あからさま」(露骨)とは違う" },
  { no: 104, ko: "かたくななり", pos: "形動", page: 117, ja: "情趣を解さない・頑固だ・見苦しい", ex: "人の心を知らぬそのふるまひ〔かたくななり〕。", exja: "人の心を知らないそのふるまいは【見苦しい】。", kana: "みぐるしい" },
  { no: 105, ko: "あだなり", pos: "形動", page: 118, ja: "はかない・不誠実だ", ex: "人の命の〔あだなる〕ことを思ひて涙落ちぬ。", exja: "人の命が【はかない】ことを思って涙が落ちた。", kana: "はかない" },
  { no: 106, ko: "すずろなり", pos: "形動", page: 118, ja: "あてもない・思いがけない・むやみに", ex: "〔すずろに〕野を歩みゆくほどに日暮れにけり。", exja: "【あてもなく】野原を歩いて行くうちに日が暮れた。", kana: "あてもなく" },
  { no: 107, ko: "むげなり", pos: "形動", page: 119, ja: "まったくひどい・むやみに", ex: "人前にてかかるふるまひはまことに〔むげなり〕。", exja: "人前でこのようなふるまいをするのは本当に【まったくひどい】。", kana: "まったくひどい" },
  { no: 108, ko: "おほやけ", pos: "名", page: 120, ja: "朝廷・天皇・公的なこと", ex: "〔おほやけ〕に仕へて早くも十年を経にけり。", exja: "【朝廷】にお仕えして早くも十年が過ぎた。", kana: "ちょうてい", nu: "対義語は「わたくし」(私事)" },
  { no: 109, ko: "きは", kanji: "際", pos: "名", page: 120, ja: "身分・程度", ex: "その〔きは〕いと高き人の子にぞありける。", exja: "その【身分】がたいそう高い人の子であった。", kana: "みぶん" },
  { no: 110, ko: "しるし", kanji: "験・徴", pos: "名", page: 121, ja: "ご利益・効果・前兆", ex: "神に祈りし〔しるし〕ありて病は癒えにけり。", exja: "神に祈った【ご利益】があって病気は治った。", kana: "ごりやく" },
  { no: 111, ko: "ことわり", kanji: "理", pos: "名", page: 122, ja: "道理・理由", ex: "君の怒り給ふもまことに〔ことわり〕なりけり。", exja: "主君がお怒りになるのも本当に【道理】であった。", kana: "どうり", nu: "「ことわりなり」で「当然だ」の意も" },
  { no: 112, ko: "ためし", kanji: "例", pos: "名", page: 122, ja: "例・語り草", ex: "かかる事は昔にも〔ためし〕なかりけり。", exja: "このようなことは昔にも【例】がなかった。", kana: "れい" },
  { no: 113, ko: "わざ", pos: "名", page: 123, ja: "仏事・行い", ex: "亡き父のために寺にて心をこめて〔わざ〕を営みけり。", exja: "亡き父のために寺で心をこめて【仏事】を営んだ。", kana: "ぶつじ", nu: "入試では「仏事」の意が頻出" },
  { no: 114, ko: "おぼえ", pos: "名", page: 124, ja: "評判・寵愛（を受けること）", ex: "この君は世に〔おぼえ〕高き人にて、人みな頼みけり。", exja: "この方は世間で【評判】が高い人で、人はみな頼りにした。", kana: "ひょうばん" },
  { no: 115, ko: "ここち", kanji: "心地", pos: "名", page: 124, ja: "気持ち・病気", ex: "春の野に出でて、いとのどけき〔ここち〕しけり。", exja: "春の野に出て、たいそうのどかな【気持ち】がした。", kana: "きもち", nu: "「御心地」は病気を婉曲に表す" },
  { no: 116, ko: "うつつ", kanji: "現", pos: "名", page: 125, ja: "現実・正気", ex: "夢か〔うつつ〕かと分かぬまま、夜を明かしけり。", exja: "夢か【現実】か分からないまま、夜を明かした。", kana: "げんじつ" },
  { no: 117, ko: "つとめて", pos: "名", page: 126, ja: "早朝・翌朝", ex: "雪降れる〔つとめて〕、童を率て庭に出でにけり。", exja: "雪の降った【早朝】、子どもを連れて庭に出た。", kana: "そうちょう", nu: "「その日の翌朝」の意が本来的" },
  { no: 118, ko: "つごもり", pos: "名", page: 126, ja: "月末", ex: "三月の〔つごもり〕に、庭の花は散りはてにけり。", exja: "三月の【月末】に、庭の花はすっかり散ってしまった。", kana: "げつまつ" },
  { no: 119, ko: "ついで", pos: "名", page: 127, ja: "（物事の）順序・機会", ex: "物語する〔ついで〕に、昔の恋のことを語りき。", exja: "話をする【機会】に、昔の恋のことを語った。", kana: "きかい" },
  { no: 120, ko: "たより", pos: "名", page: 128, ja: "頼れるもの・縁故・便宜・機会", ex: "都に〔たより〕ありければ、子を上らせて学ばしむ。", exja: "都に【縁故】があったので、子を上京させて学ばせる。", kana: "えんこ", nu: "現代語「手紙」の意はほぼ無い" },
  { no: 121, ko: "こころざし", pos: "名", page: 129, ja: "愛情・贈り物", ex: "年月を経ても深き〔こころざし〕は変はらざりけり。", exja: "年月を経ても深い【愛情】は変わらなかった。", kana: "あいじょう" },
  { no: 122, ko: "よし", kanji: "由", pos: "名", page: 130, ja: "縁・方法・由緒・事情・そぶり", ex: "雨いたく降れば、山に入らむ〔よし〕もなくて帰りぬ。", exja: "雨がひどく降るので、山に入る【方法】もなくて帰った。", kana: "ほうほう" },
  { no: 123, ko: "よろづ", kanji: "万", pos: "名", page: 131, ja: "さまざまなこと・すべて", ex: "世の〔よろづ〕を見聞きして、静かに老いにけり。", exja: "世の中の【さまざまなこと】を見聞きして、静かに年老いた。", kana: "さまざまなこと" },
  { no: 124, ko: "て", pos: "名", page: 132, ja: "筆跡・演奏法", ex: "この人の書ける文の〔て〕は、いとうつくしかりけり。", exja: "この人が書いた手紙の【筆跡】は、たいそう美しかった。", kana: "ひっせき" },
  { no: 125, ko: "ざえ", kanji: "才", pos: "名", page: 132, ja: "学問・学識", ex: "この人〔ざえ〕深くありて、若くて帝に仕へけり。", exja: "この人は【学識】が深くて、若くして帝にお仕えした。", kana: "がくしき" },
  { no: 126, ko: "おのづから", pos: "副", page: 136, ja: "自然に・偶然に・万一", ex: "月日のいたく経れば、〔おのづから〕忘れぬべし。", exja: "月日がひどくたてば、【自然に】忘れてしまうだろう。", kana: "しぜんに" },
  { no: 127, ko: "すなはち", pos: "副", page: 137, ja: "すぐに・そこで", ex: "御召しありければ〔すなはち〕装束して参りにけり。", exja: "お召しがあったので【すぐに】装束をつけて参上した。", kana: "すぐに" },
  { no: 128, ko: "とく", pos: "副", page: 137, ja: "早く・すでに", ex: "日も暮れにければ、〔とく〕我が家に帰りなむ。", exja: "日も暮れたので、【早く】我が家に帰ろう。", kana: "はやく", nu: "「はやくに」から「すでに」の意も" },
  { no: 129, ko: "いつしか", pos: "副", page: 138, ja: "いつのまにか・早く", ex: "〔いつしか〕秋の風立ちて、袖の寒くなりにけり。", exja: "秋の風が【いつのまにか】立って、袖が寒くなった。", kana: "いつのまにか", nu: "願望文以外は「いつのまにか」の意" },
  { no: 130, ko: "なべて", pos: "副", page: 138, ja: "総じて・普通", ex: "世の人は〔なべて〕春の花を愛づるものなりけり。", exja: "世の人は【総じて】春の花を愛するものであった。", kana: "そうじて", nu: "下に打消を伴うことが多い" },
  { no: 131, ko: "いとど", pos: "副", page: 139, ja: "いっそう", ex: "雨降れば〔いとど〕道のあしくなりて、え行かず。", exja: "雨が降るので【いっそう】道が悪くなって、行けない。", kana: "いっそう" },
  { no: 132, ko: "かく", pos: "副", page: 140, ja: "このように", ex: "われ〔かく〕言へば、人みな声をあげて笑ひけり。", exja: "私が【このように】言うと、人はみな声をあげて笑った。", kana: "このように" },
  { no: 133, ko: "とかく", pos: "副", page: 140, ja: "あれこれと", ex: "〔とかく〕思ひ煩ひて、まどろまで夜を明かしけり。", exja: "【あれこれと】思い悩んで、眠らずに夜を明かした。", kana: "あれこれと" },
  { no: 134, ko: "しか", pos: "副", page: 141, ja: "そのように", ex: "主〔しか〕のたまへば、みな従ひ奉りて出でにけり。", exja: "主人が【そのように】おっしゃるので、みな従い申し上げて出発した。", kana: "そのように" },
  { no: 135, ko: "さ", pos: "副", page: 142, ja: "そう", ex: "世の中は〔さ〕こそあらめと思ひて、嘆くことやみぬ。", exja: "世の中は【そう】であろうと思って、嘆くことをやめた。", kana: "そう" },
  { no: 136, ko: "さばかり", pos: "副", page: 143, ja: "その程度・非常に", ex: "〔さばかり〕騒ぎし人も、今はいと静かになりぬ。", exja: "【非常に】騒いだ人も、今はたいそう静かになった。", kana: "ひじょうに", nu: "「さ」を受けてその程度を表す" },
  { no: 137, ko: "さながら", pos: "副", page: 144, ja: "そのまま・全部", ex: "十年を経ても昔のさま〔さながら〕にて残りけり。", exja: "十年たっても昔の様子が【そのまま】で残っていた。", kana: "そのまま", nu: "現代語「まるで」の意ではない" },
  { no: 138, ko: "つゆ", pos: "副", page: 144, ja: "少しも〜ない", ex: "人みな知れる事を、われは〔つゆ〕知らざりけり。", exja: "人がみな知っていることを、私は【少しも】知らなかった。", kana: "すこしも", nu: "下に打消を伴う呼応の副詞" },
  { no: 139, ko: "よも", pos: "副", page: 145, ja: "まさか〜ないだろう", ex: "かの人は〔よも〕偽りを言はじと頼もしく思ふ。", exja: "あの人は【まさか】うそは言うまいと頼もしく思う。", kana: "まさか", nu: "下に「じ」を伴う呼応の副詞" },
  { no: 140, ko: "なかなか", pos: "副", page: 146, ja: "かえって・なまじ", ex: "言葉少なきぞ〔なかなか〕あはれに聞こえける。", exja: "言葉が少ないほうが【かえって】しみじみと聞こえた。", kana: "かえって", nu: "現代語の「なかなか」と意味が違う" },
  { no: 141, ko: "さすがに", pos: "副", page: 146, ja: "そうはいってもやはり", ex: "憎しと思へど、〔さすがに〕言ひ出でがたし。", exja: "憎いと思うが、【そうはいってもやはり】言い出しにくい。", kana: "そうはいってもやはり" },
  { no: 142, ko: "かつ", pos: "副", page: 147, ja: "一方では・すぐに", ex: "にはかに雨降りて、〔かつ〕日の照ること侍り。", exja: "急に雨が降って、【一方では】日が照ることがございます。", kana: "いっぽうでは", nu: "一方と継起の両方を表す" },
  { no: 143, ko: "など", pos: "副", page: 148, ja: "どうして", ex: "〔など〕かく心細くはおぼゆるらむ。", exja: "【どうして】こんなに心細く思われるのだろう。", kana: "どうして", nu: "疑問・反語表現に用いる", alt: ["などか"] },
  { no: 144, ko: "なんでふ", pos: "副", page: 149, ja: "どうして・なんという", ex: "〔なんでふ〕さることをば人に申すぞ。", exja: "【どうして】そのようなことを人に申すのか。", kana: "どうして", nu: "驚きや非難を込めた疑問", alt: ["なでふ"] },
  { no: 145, ko: "ありし", pos: "連体", page: 150, ja: "さっきの", ex: "〔ありつる〕人の言葉ぞ心にとまりける。", exja: "【さっきの】人の言葉が心に残った。", kana: "さっきの", nu: "「ありし」より直前を指す" },
  { no: 145, ko: "ありつる", pos: "連体", page: 150, ja: "さっきの", ex: "〔ありつる〕人の言葉ぞ心にとまりける。", exja: "【さっきの】人の言葉が心に残った。", kana: "さっきの", nu: "「ありし」より直前を指す" },
  { no: 146, ko: "れいの", kanji: "例の", pos: "連語", page: 150, ja: "いつものように・いつもの", ex: "〔例の〕夜更けてより文を書きはじめぬ。", exja: "【いつものように】夜が更けてから手紙を書きはじめた。", kana: "いつものように" },
  { no: 147, ko: "おとにきく", pos: "連語", page: 151, ja: "うわさに聞く・評判が高い", ex: "〔音に聞く〕滝を見むとて深き山に入りぬ。", exja: "【うわさに聞く】滝を見ようと思って深い山に入った。", kana: "うわさにきく", nu: "「音に聞こゆ」とも言う" },
  { no: 148, ko: "いかがせむ", pos: "連語", page: 152, ja: "どうしようか・どうしようもない", ex: "道は雪に絶えぬ、〔いかがせむ〕とぞ嘆きける。", exja: "道は雪で絶えてしまった、【どうしようか】と嘆いた。", kana: "どうしようか", nu: "多くは反語表現", alt: ["いかがはせむ"] },
  { no: 149, ko: "さるべき", pos: "連語", page: 152, ja: "（そうするのが）適当な・そうなるはずの", ex: "〔さるべき〕人をたづねて事の理を問はむ。", exja: "【適当な】人を訪ねて物事の道理を尋ねよう。", kana: "てきとうな", nu: "「べし」の当然の意を含む" },
  { no: 150, ko: "いざたまへ", pos: "連語", page: 153, ja: "さあ、（一緒に）いらっしゃい", ex: "花の盛りなり、〔いざたまへ〕、野辺に出でむ。", exja: "花の盛りである、【さあいらっしゃい】、野原に出よう。", kana: "さあいらっしゃい", nu: "勧誘表現、命令ではない" },
  { no: 151, ko: "のたまはす", pos: "動", page: 158, ja: "おっしゃる", ex: "帝の〔のたまはする〕言葉をかしこみ侍りけり。", exja: "帝が【おっしゃる】お言葉を恐れ多く思っておりました。", kana: "おっしゃる", nu: "「のたまふ」より高い敬意", alt: ["のたまふ"] },
  { no: 152, ko: "おほす", pos: "動", page: 158, ja: "おっしゃる・命じる", ex: "殿の〔おほする〕ことにはひたぶるに従ひ侍り。", exja: "殿が【おっしゃる】ことにはひたすら従っております。", kana: "おっしゃる", nu: "命令の意味でも使う" },
  { no: 153, ko: "きこしめす", pos: "動", page: 159, ja: "お聞きになる・召し上がる", ex: "帝は民の訴へをねんごろに〔きこしめす〕なり。", exja: "帝は民の訴えを丁寧に【お聞きになる】のである。", kana: "おききになる" },
  { no: 154, ko: "ごらんず", pos: "動", page: 160, ja: "ご覧になる", ex: "宮、雲間の月を〔ごらんずる〕に、涙落ちけり。", exja: "宮が雲間の月を【ご覧になる】と、涙が落ちた。", kana: "ごらんになる" },
  { no: 155, ko: "まうす", pos: "動", page: 160, ja: "申し上げる・（お）～申し上げる", ex: "おのが思ふところをつぶさに君に〔まうす〕べし。", exja: "自分の思うところを詳しく主君に【申し上げる】のがよい。", kana: "もうしあげる" },
  { no: 156, ko: "きこえさす", pos: "動", page: 161, ja: "申し上げる・（お）〜申し上げる", ex: "姫君のもとに夜もすがら文を書きて〔きこえさす〕。", exja: "姫君のもとに一晩中手紙を書いて【申し上げる】。", kana: "もうしあげる", nu: "「きこゆ」より敬意が強い", alt: ["きこゆ"] },
  { no: 157, ko: "おはします", pos: "動", page: 162, ja: "いらっしゃる・〜ていらっしゃる", ex: "大臣は東の対にこそ今も〔おはしませ〕。", exja: "大臣は東の対に今も【いらっしゃる】。", kana: "いらっしゃる", nu: "「おはす」より敬意が強い", alt: ["おはす"] },
  { no: 158, ko: "おぼしめす", pos: "動", page: 163, ja: "お思いになる", ex: "帝は世の乱れをいと憂しと〔おぼしめす〕。", exja: "帝は世の乱れをたいそうつらいと【お思いになる】。", kana: "おおもいになる", alt: ["おぼす"] },
  { no: 159, ko: "たまふ", pos: "動", page: 164, ja: "お与えになる・お〜になる", ex: "君はつかへし者どもに衣を〔たまふ〕。", exja: "主君はお仕えした者たちに着物を【お与えになる】。", kana: "おあたえになる", nu: "四段=尊敬、下二段=謙譲" },
  { no: 160, ko: "たまふ", pos: "動", page: 164, ja: "〜ております", ex: "げに我もさやうにこそ思ひ〔たまふれ〕。", exja: "本当に私もそのように思っ【ております】。", kana: "ております", nu: "謙譲の補助動詞、会話文で頻出" },
  { no: 161, ko: "たまはす", pos: "動", page: 165, ja: "お与えになる", ex: "帝、忠あつき者に広き領を〔たまはす〕。", exja: "帝は忠義の厚い者に広い領地を【お与えになる】。", kana: "おあたえになる", nu: "「たまふ」より敬意が高い" },
  { no: 162, ko: "たまはる", pos: "動", page: 166, ja: "いただく", ex: "けふ我は君より新しき衣を〔たまはる〕。", exja: "今日私は主君から新しい着物を【いただく】。", kana: "いただく", nu: "「たまふ」と逆で「もらう」の意" },
  { no: 163, ko: "うけたまはる", pos: "動", page: 166, ja: "お受けする・お聞きする", ex: "我つつしみて仰せの旨を〔うけたまはる〕。", exja: "私は謹んでご命令の趣旨を【お聞きする】。", kana: "おききする", nu: "「聞く」の謙譲語、敬意高い" },
  { no: 164, ko: "たてまつる", pos: "動", page: 167, ja: "差し上げる・（お）〜申し上げる・お召しになる", ex: "野に出でて花を折り、姫君に〔たてまつる〕。", exja: "野原に出て花を折って、姫君に【差し上げる】。", kana: "さしあげる", nu: "「お召しになる」は尊敬用法" },
  { no: 165, ko: "はべり", kanji: "侍り", pos: "動", page: 168, ja: "お仕えする・〜（ござい）ます", ex: "我は幼きより宮のもとに〔侍り〕。", exja: "私は幼いころから宮のもとに【お仕えする】。", kana: "おつかえする", nu: "「さぶらふ」とほぼ同義" },
  { no: 166, ko: "さぶらふ", kanji: "候ふ", pos: "動", page: 168, ja: "お仕えする・〜（ござい）ます", ex: "女房ら夜もすがら御前に〔候ふ〕。", exja: "女房たちは一晩中お側に【お仕えする】。", kana: "おつかえする", nu: "「はべり」とほぼ同義" },
  { no: 167, ko: "めす", kanji: "召す", pos: "動", page: 169, ja: "お呼び寄せになる・召し上がる・お召しになる", ex: "帝は御遊びのために楽人を庭に〔召す〕。", exja: "帝は管絃の遊びのために楽人を庭に【お呼び寄せになる】。", kana: "およびよせになる" },
  { no: 168, ko: "まうづ", pos: "動", page: 170, ja: "参上する・参詣する", ex: "年ごろの願ありて、はるかなる山の寺に〔まうづ〕。", exja: "長年の願いがあって、遠い山寺に【参詣する】。", kana: "さんけいする", nu: "貴人や神仏に使う謙譲語" },
  { no: 169, ko: "まゐる", pos: "動", page: 170, ja: "参上する・差し上げる・召し上がる", ex: "召しありければ、いそぎ御前に〔まゐる〕。", exja: "お呼びがあったので、急いで御前に【参上する】。", kana: "さんじょうする", nu: "謙譲語・尊敬語の両方あり" },
  { no: 170, ko: "まゐらす", pos: "動", page: 171, ja: "差し上げる・（お）～申し上げる", ex: "御文を書きて、姫君のもとに〔まゐらす〕。", exja: "お手紙を書いて、姫君のもとに【差し上げる】。", kana: "さしあげる", nu: "謙譲の補助動詞としても使う" },
  { no: 171, ko: "まかる", pos: "動", page: 172, ja: "退出する・参ります", ex: "夜更けぬれば、いとまを申して宮より〔まかる〕。", exja: "夜が更けたので、おいとまを申し上げて宮から【退出する】。", kana: "たいしゅつする", nu: "「行く/来る」の謙譲語でもある" },
  { no: 172, ko: "まかづ", pos: "動", page: 172, ja: "退出する・出かけます", ex: "暇を賜りて、今日ひさしく里に〔まかづ〕るなり。", exja: "休暇をいただいて、今日久しぶりに実家に【退出する】のである。", kana: "たいしゅつする", nu: "「行く」の謙譲語でもある" },
  { no: 173, ko: "つかはす", pos: "動", page: 173, ja: "おやりになる・お与えになる・贈る", ex: "殿は、御文を持たせて使ひを遠き国に〔つかはす〕。", exja: "殿は、お手紙を持たせて使者を遠い国に【おやりになる】。", kana: "おやりになる", nu: "「やる/与ふ」の尊敬語" },
  { no: 174, ko: "あそばす", pos: "動", page: 174, ja: "演奏をなさる・〜（を）なさる", ex: "月の明き夜、殿は御前にて琴を〔あそばす〕。", exja: "月の明るい夜、殿は御前で琴を【演奏なさる】。", kana: "えんそうなさる", nu: "「なさる」の尊敬語" },
  { no: 175, ko: "つかうまつる", pos: "動", page: 174, ja: "お仕え申し上げる・（お）〜申し上げる", ex: "われもこの殿に、心を尽くして〔つかうまつる〕。", exja: "私もこの殿に、心を尽くして【お仕え申し上げる】。", kana: "おつかえもうしあげる", nu: "「仕ふ」の謙譲語" },
  { no: 176, ko: "おほとのごもる", pos: "動", page: 175, ja: "おやすみになる", ex: "夜更けぬれば、君は奥の御殿にて〔おほとのごもる〕。", exja: "夜が更けたので、殿は奥の御殿で【おやすみになる】。", kana: "おやすみになる", nu: "「寝」の最高敬語" },
  { no: 177, ko: "しろしめす", pos: "動", page: 176, ja: "ご存じである・お治めになる", ex: "帝は四方の国を久しく安らかに〔しろしめす〕。", exja: "天皇は四方の国を長く平穏に【お治めになる】。", kana: "おおさめになる", nu: "「知る」の尊敬語" },
  { no: 178, ko: "ごかう", kanji: "御幸", pos: "名", page: 176, ja: "皇后・皇太子などのお出かけ", ex: "寺に、宮の〔ぎやうけい〕ありて、道を清めけり。", exja: "寺に、皇后の【お出かけ】があって、道を清めた。", kana: "おでかけ", nu: "皇后・皇太子に使う語" },
  { no: 178, ko: "ぎやうがう", kanji: "行幸", pos: "名", page: 176, ja: "皇后・皇太子などのお出かけ", ex: "寺に、宮の〔ぎやうけい〕ありて、道を清めけり。", exja: "寺に、皇后の【お出かけ】があって、道を清めた。", kana: "おでかけ", nu: "皇后・皇太子に使う語" },
  { no: 178, ko: "ぎやうけい", kanji: "行啓", pos: "名", page: 176, ja: "皇后・皇太子などのお出かけ", ex: "寺に、宮の〔ぎやうけい〕ありて、道を清めけり。", exja: "寺に、皇后の【お出かけ】があって、道を清めた。", kana: "おでかけ", nu: "皇后・皇太子に使う語" },
  { no: 179, ko: "そうす", kanji: "奏す", pos: "動", page: 177, ja: "（天皇・上皇に）申し上げる", ex: "使ひ帰りて、道のありさまを帝に〔奏す〕。", exja: "使者が帰って、道中の様子を天皇に【申し上げる】。", kana: "もうしあげる", nu: "対象は天皇・上皇のみ" },
  { no: 180, ko: "けいす", kanji: "啓す", pos: "動", page: 177, ja: "（皇后・皇太子に）申し上げる", ex: "女房まゐりて、御返り事を中宮に〔啓す〕。", exja: "女房が参上して、お返事を皇后に【申し上げる】。", kana: "もうしあげる", nu: "対象は中宮・皇太子のみ" },
  { no: 181, ko: "しる", pos: "動", page: 184, ja: "治める・領有する", ex: "この山も川も、みなわが家の〔しる〕ところなり。", exja: "この山も川も、みな我が家が【領有する】所である。", kana: "りょうゆうする", nu: "「知る」の特殊な意味" },
  { no: 182, ko: "あくがる", pos: "動", page: 184, ja: "さまよい出る・（魂が）宙にさまよう", ex: "もの思ふ秋の夜は、たましひも身より〔あくがる〕。", exja: "物思いにふける秋の夜は、魂も体から【さまよい出る】。", kana: "さまよいでる" },
  { no: 183, ko: "やすらふ", pos: "動", page: 185, ja: "立ち止まる・ためらう", ex: "にはかに雨降れば、門の前にしばし〔やすらふ〕。", exja: "急に雨が降るので、門の前でしばらく【立ち止まる】。", kana: "たちどまる", nu: "現代語の「休む」とは違う" },
  { no: 184, ko: "うちいづ", pos: "動", page: 186, ja: "口に出して言う・言い出す", ex: "年ごろ思ふことを、つひに友に〔うちいづ〕。", exja: "長年思っていることを、とうとう友に【口に出して言う】。", kana: "くちにだしていう" },
  { no: 185, ko: "やつす", pos: "動", page: 186, ja: "地味な格好にする・目立たなくする", ex: "人目を忍ばむとて、山伏のごとくわが姿を〔やつす〕。", exja: "人目を避けようとして、山伏のように自分の姿を【地味な格好にする】。", kana: "じみなかっこうにする", nu: "出家・変装の場面で頻出" },
  { no: 186, ko: "おとなふ", pos: "動", page: 187, ja: "音を立てる・手紙を出す・訪れる", ex: "風吹きて、庭の木の葉の〔おとなふ〕夜なり。", exja: "風が吹いて、庭の木の葉が【音を立てる】夜である。", kana: "おとをたてる", nu: "「訪れる」の意味に注意" },
  { no: 187, ko: "そばむ", pos: "動", page: 188, ja: "横を向く", ex: "人に見らるるが恥づかしくて、少し〔そばむ〕。", exja: "人に見られるのが恥ずかしくて、少し【横を向く】。", kana: "よこをむく" },
  { no: 188, ko: "かたらふ", pos: "動", page: 188, ja: "交際する・親しく語り合う・言い寄る", ex: "年ごろ心へだてなく〔かたらふ〕友の一人あり。", exja: "長年、心の隔てなく【交際する】友が一人いる。", kana: "こうさいする", nu: "説得する意味もある" },
  { no: 189, ko: "すむ", pos: "動", page: 189, ja: "（男が女のもとに）通う", ex: "かの男、今も夜ごとに忍びてこの家に〔すむ〕。", exja: "その男は、今も毎晩こっそりこの家に【通う】。", kana: "かよう", nu: "通い婚の慣習を表す語" },
  { no: 190, ko: "さはる", pos: "動", page: 189, ja: "妨げられる・差し支える", ex: "にはかなる雨に〔さはり〕て、出で立つことかなはず。", exja: "急な雨に【妨げられ】て、出発することができない。", kana: "さまたげられ" },
  { no: 191, ko: "あるじす", pos: "動", page: 190, ja: "客にごちそうする", ex: "遠き客来たれば、心をつくして〔あるじす〕。", exja: "遠方の客が来たので、心を尽くして【ごちそうする】。", kana: "ごちそうする" },
  { no: 192, ko: "もてなす", pos: "動", page: 190, ja: "振る舞う・取り扱う・もてはやす", ex: "人々の中にても、つねに静かに〔もてなす〕。", exja: "人々の中でも、いつも静かに【振る舞う】。", kana: "ふるまう", nu: "「取り扱う」の意味に注意" },
  { no: 193, ko: "きようず", kanji: "興ず", pos: "動", page: 191, ja: "おもしろがる", ex: "いとをかしき歌を聞きて、人々みな〔興ず〕。", exja: "とても趣のある歌を聞いて、人々はみな【おもしろがる】。", kana: "おもしろがる" },
  { no: 194, ko: "およすぐ", pos: "動", page: 192, ja: "成長する・大人びる", ex: "この児、いつしか〔およすぎ〕て、もの言ふさまも変はりぬ。", exja: "この子はいつのまにか【大人び】て、物を言う様子も変わった。", kana: "おとなび" },
  { no: 195, ko: "ときめく", pos: "動", page: 192, ja: "寵愛を受ける・栄える", ex: "宮仕へする人の中に、いみじう〔ときめく〕人あり。", exja: "宮仕えする人の中に、たいそう【寵愛を受ける】人がいる。", kana: "ちょうあいをうける", nu: "現代語の「ときめく」とは別語" },
  { no: 196, ko: "さる", kanji: "避る", pos: "動", page: 193, ja: "避ける・遠ざかる", ex: "人目を〔さら〕むとて、暁に山路をたどりけり。", exja: "人目を【避ける】ために、明け方に山道をたどった。", kana: "さける", nu: "「去る」とは別語(避ける意)" },
  { no: 197, ko: "こうず", kanji: "困ず", pos: "動", page: 194, ja: "疲れる・弱る", ex: "長き道に〔こうずる〕人、供の中にあまたありけり。", exja: "長い道で【疲れる】人が、お供の中に大勢いた。", kana: "つかれる" },
  { no: 198, ko: "かきくらす", pos: "動", page: 194, ja: "悲嘆に暮れる・空を暗くする", ex: "別れの文を見て、女いたく〔かきくらす〕。", exja: "別れの手紙を見て、女はひどく【悲しみに暮れる】。", kana: "かなしみにくれる" },
  { no: 199, ko: "うれふ", pos: "動", page: 195, ja: "訴える・嘆く・思い悩む", ex: "里の民ども、国司に年貢の重きことを〔うれふ〕。", exja: "里の民たちが、国司に年貢が重いことを【訴える】。", kana: "うったえる", nu: "「嘆く」の意もある" },
  { no: 200, ko: "かこつ", pos: "動", page: 195, ja: "不平を言う・嘆く", ex: "下人ども、日ごろの役目の多きを〔かこつ〕なり。", exja: "召使いたちが、ふだんの役目の多いことに【不平を言う】のだ。", kana: "ふへいをいう" },
  { no: 201, ko: "いたはる", pos: "動", page: 196, ja: "病気になる・骨を折る・世話をする", ex: "老いたる親を〔いたはら〕むとて、薬を求めありく。", exja: "年老いた親を【世話する】ために、薬を求めて歩き回る。", kana: "せわする" },
  { no: 202, ko: "ためらふ", pos: "動", page: 196, ja: "静養する・気を静める", ex: "文を見ていたく驚きたれば、しばし〔ためらふ〕べし。", exja: "手紙を見てひどく驚いたので、しばらく【気を静める】のがよい。", kana: "きをしずめる", nu: "現代語の「ためらう」とは意味が違う" },
  { no: 203, ko: "おこたる", pos: "動", page: 197, ja: "病気がよくなる・怠ける", ex: "年ごろの病も、湯にひたらば〔おこたる〕べし。", exja: "長年の病気も、湯に入れば【よくなる】だろう。", kana: "よくなる", nu: "「病気が治る」の意に注意" },
  { no: 204, ko: "なやむ", pos: "動", page: 198, ja: "病気で苦しむ・思い悩む", ex: "幼き子、夜もすがら熱に〔なやむ〕をあはれと見る。", exja: "幼い子が一晩中熱で【病み苦しむ】のをかわいそうだと見る。", kana: "やみくるしむ" },
  { no: 205, ko: "おくる", pos: "動", page: 198, ja: "先立たれる・劣る", ex: "人の親の子に〔おくるる〕ばかり悲しきことはなし。", exja: "親が子に【先立たれる】ほど悲しいことはない。", kana: "さきだたれる", nu: "「送る」とは別語(死別の意)" },
  { no: 206, ko: "したたむ", pos: "動", page: 199, ja: "処理する・用意する・取り締まる・書き記す", ex: "明日の旅の料、今宵のうちに〔したたむ〕べし。", exja: "明日の旅の食料を、今夜のうちに【用意する】のがよい。", kana: "よういする" },
  { no: 207, ko: "あたらし", pos: "形", page: 202, ja: "もったいない・惜しい", ex: "かかる才ある人を用ゐぬこそ〔あたらしけれ〕。", exja: "これほど才能のある人を用いないのは【もったいない】。", kana: "もったいない", nu: "現代語の「新しい」ではない" },
  { no: 208, ko: "かたじけなし", pos: "形", page: 202, ja: "おそれ多い・ありがたい", ex: "身に余る御言葉をたまはりて、いと〔かたじけなし〕。", exja: "身に余るお言葉をいただいて、たいそう【おそれ多い】。", kana: "おそれおおい" },
  { no: 209, ko: "をこがまし", pos: "形", page: 203, ja: "愚かしい・差し出がましい", ex: "知らぬことを知り顔に言ふは〔をこがまし〕。", exja: "知らないことを知ったふうに言うのは【愚かしい】。", kana: "おろかしい" },
  { no: 210, ko: "こころにくし", pos: "形", page: 204, ja: "奥ゆかしい", ex: "垣間見ゆる庭のさま、いと〔こころにくし〕。", exja: "ちらりと見える庭の様子は、たいそう【奥ゆかしい】。", kana: "おくゆかしい" },
  { no: 211, ko: "さかし", pos: "形", page: 204, ja: "かしこい・こざかしい", ex: "この童、年のほどよりもの言ふさまいと〔さかし〕。", exja: "この子どもは、年齢の割に物を言う様子がたいそう【かしこい】。", kana: "かしこい", nu: "皮肉で「こざかしい」の意にも" },
  { no: 212, ko: "すきずきし", pos: "形", page: 205, ja: "好色めいている・風流だ", ex: "花に文結びつくるさま、いと〔すきずきし〕。", exja: "花に手紙を結びつける様子は、たいそう【風流だ】。", kana: "ふうりゅうだ" },
  { no: 213, ko: "なまめかし", pos: "形", page: 206, ja: "優美だ・若々しい", ex: "月の光のもとに立てる姿、いと〔なまめかし〕。", exja: "月の光のもとに立っている姿は、たいそう【優美だ】。", kana: "ゆうびだ", nu: "現代語より上品な意味" },
  { no: 214, ko: "いまめかし", pos: "形", page: 206, ja: "現代風だ・華やかだ", ex: "若き人の装束のさま、いと〔いまめかし〕。", exja: "若い人の衣装の様子は、たいそう【華やかだ】。", kana: "はなやかだ" },
  { no: 215, ko: "しどけなし", pos: "形", page: 207, ja: "無造作だ・乱れている", ex: "夜更けて帰る人の姿、いと〔しどけなし〕。", exja: "夜更けに帰る人の姿は、たいそう【無造作だ】。", kana: "むぞうさだ", nu: "だらしなさが魅力的な意も" },
  { no: 216, ko: "つきづきし", pos: "形", page: 208, ja: "似つかわしい", ex: "秋の夕べに聞こゆる笛の音こそ〔つきづきしけれ〕。", exja: "秋の夕方に聞こえる笛の音は【似つかわしい】。", kana: "につかわしい" },
  { no: 217, ko: "なつかし", pos: "形", page: 208, ja: "好ましい・心引かれる", ex: "その人の書きたる文字、いと〔なつかし〕。", exja: "その人が書いた文字は、たいそう【好ましい】。", kana: "このましい", nu: "現代語の「昔を懐かしむ」の意ではない" },
  { no: 218, ko: "めやすし", pos: "形", page: 209, ja: "感じがよい・見苦しくない", ex: "客の前にてのふるまひ、いと〔めやすし〕。", exja: "客の前でのふるまいは、たいそう【見苦しくない】。", kana: "みぐるしくない" },
  { no: 219, ko: "こころやすし", pos: "形", page: 209, ja: "安心だ・気楽だ", ex: "旅の宿に知る人あれば、いと〔こころやすし〕。", exja: "旅の宿に知人がいるので、たいそう【安心だ】。", kana: "あんしんだ" },
  { no: 220, ko: "うしろめたし", pos: "形", page: 210, ja: "心配だ・気がかりだ", ex: "幼き子を家に置きて出づるは〔うしろめたし〕。", exja: "幼い子を家に置いて出かけるのは【心配だ】。", kana: "しんぱいだ", nu: "現代語の「罪悪感」の意ではない" },
  { no: 221, ko: "こころぐるし", pos: "形", page: 210, ja: "つらい・気の毒だ", ex: "人の嘆くさまを見るは、いと〔こころぐるし〕。", exja: "人が嘆く様子を見るのは、たいそう【気の毒だ】。", kana: "きのどくだ" },
  { no: 222, ko: "まばゆし", pos: "形", page: 211, ja: "まぶしい・見ていられない・恥ずかしい", ex: "人の前にてほめらるるは、いと〔まばゆし〕。", exja: "人の前で褒められるのは、たいそう【恥ずかしい】。", kana: "はずかしい", nu: "原義は「まぶしい」" },
  { no: 223, ko: "はづかし", pos: "形", page: 212, ja: "（こちらが気後れするほど）立派だ", ex: "かの人の才は〔はづかしく〕、われは物も言はれず。", exja: "あの人の学識は【立派】で、私は何も言えない。", kana: "りっぱ", nu: "現代語の「恥ずかしい」とは違う" },
  { no: 224, ko: "つたなし", pos: "形", page: 212, ja: "下手だ・劣っている・不運だ", ex: "わが筆跡は〔つたなく〕て、人に見すべくもあらず。", exja: "私の筆跡は【下手】で、人に見せられそうもない。", kana: "へた", nu: "「不運だ」の意味も重要" },
  { no: 225, ko: "こちたし", pos: "形", page: 213, ja: "仰々しい・はなはだしい", ex: "供の者あまた具して、いと〔こちたき〕ありさまなり。", exja: "供の者を大勢連れて、たいそう【仰々しい】様子である。", kana: "ぎょうぎょうしい" },
  { no: 226, ko: "さうなし", kanji: "左右無し", pos: "形", page: 214, ja: "ためらわない・無造作だ・たやすい", ex: "かの武士は〔さうなく〕敵の陣に駆け入りぬ。", exja: "あの武士は【ためらわず】敵の陣に駆け込んだ。", kana: "ためらわず" },
  { no: 227, ko: "ところせし", pos: "形", page: 214, ja: "いっぱいだ・窮屈だ・おおげさだ", ex: "庭に人あまた集ひて、いと〔ところせし〕。", exja: "庭に人が大勢集まって、たいそう【いっぱい】だ。", kana: "いっぱい" },
  { no: 228, ko: "つつまし", pos: "形", page: 215, ja: "気がひける・恥ずかしい", ex: "人前にて物言はむことは、いと〔つつまし〕。", exja: "人前で物を言うようなことは、たいそう【気がひける】。", kana: "きがひける" },
  { no: 229, ko: "まさなし", pos: "形", page: 216, ja: "よくない・見苦しい・けしからん", ex: "かかる所にて騒ぐは〔まさなき〕わざなり。", exja: "このような所で騒ぐのは【よくない】行いである。", kana: "よくない" },
  { no: 230, ko: "ねたし", pos: "形", page: 216, ja: "しゃくにさわる・妬ましいほど見事だ", ex: "人に先を越されて、いと〔ねたし〕。", exja: "人に先を越されて、たいそう【しゃくにさわる】。", kana: "しゃくにさわる", nu: "羨ましいほど立派の意も" },
  { no: 231, ko: "まだし", pos: "形", page: 217, ja: "まだ時期が早い・不十分だ・未熟だ", ex: "花を見むには、この頃はなほ〔まだし〕。", exja: "花を見るには、この頃はやはり【時期が早い】。", kana: "じきがはやい" },
  { no: 232, ko: "はしたなし", pos: "形", page: 220, ja: "中途半端だ・はげしい・きまりが悪い", ex: "人に名を呼び違へられて、いと〔はしたなし〕。", exja: "人に名前を呼び間違えられて、たいそう【きまりが悪い】。", kana: "きまりがわるい", nu: "本来は中途半端だの意" },
  { no: 233, ko: "わりなし", pos: "形", page: 221, ja: "道理に合わない・並々ではない", ex: "さやうに人を責むるは〔わりなき〕ことなり。", exja: "そのように人を責めるのは【道理に合わない】ことである。", kana: "どうりにあわない" },
  { no: 234, ko: "ずちなし", kanji: "術無し", pos: "形", page: 222, ja: "どうしようもない", ex: "雨降り水増して、川を渡らむこと〔ずちなし〕。", exja: "雨が降り水が増して、川を渡ることは【どうしようもない】。", kana: "どうしようもない" },
  { no: 235, ko: "あへなし", pos: "形", page: 222, ja: "あっけない・はりあいがない", ex: "待ちし花の一夜にて散りて、いと〔あへなし〕。", exja: "待っていた花が一晩で散って、たいそう【あっけない】。", kana: "あっけない" },
  { no: 236, ko: "くまなし", kanji: "隈無し", pos: "形", page: 223, ja: "暗い所がない・行き届かないところがない", ex: "月いと明くて、庭の隅まで〔くまなし〕。", exja: "月がたいそう明るくて、庭の隅まで【暗い所がない】。", kana: "くらいところがない" },
  { no: 237, ko: "めざまし", pos: "形", page: 224, ja: "気にくわない・すばらしい", ex: "身分低き者の上に立つを、人々〔めざまし〕と言ふ。", exja: "身分の低い者が上に立つのを、人々は【気にくわない】と言う。", kana: "きにくわない", nu: "良い意味にも悪い意味にも" },
  { no: 238, ko: "こころづきなし", pos: "形", page: 224, ja: "気に入らない", ex: "その人の振る舞ひ、いと〔こころづきなし〕。", exja: "その人の振る舞いは、たいそう【気に入らない】。", kana: "きにいらない" },
  { no: 239, ko: "ゆくりなし", pos: "形", page: 225, ja: "突然だ・思いがけない", ex: "夜更けて〔ゆくりなく〕人の訪ね来たりけり。", exja: "夜が更けて【突然】人が訪ねて来た。", kana: "とつぜん" },
  { no: 240, ko: "あつし", pos: "形", page: 225, ja: "病状が重い", ex: "母〔あつく〕なりて、月ごろ起き上がらずなりぬ。", exja: "母は【病が重く】なって、数か月起き上がれなくなった。", kana: "やまいがおもく", nu: "「暑し」と同音の別語" },
  { no: 241, ko: "あながちなり", pos: "形動", page: 226, ja: "無理やりだ・むやみだ", ex: "友を〔あながちに〕誘ひて、山寺に籠りにけり。", exja: "友を【無理やり】誘って、山寺にこもった。", kana: "むりやり", nu: "打消と呼応し必ずしも~ない" },
  { no: 242, ko: "なめげなり", pos: "形動", page: 226, ja: "無礼だ・無作法だ", ex: "主の御前にて高く笑ふは〔なめげなり〕。", exja: "主人の御前で大声で笑うのは【無礼】だ。", kana: "ぶれい" },
  { no: 243, ko: "なのめなり", pos: "形動", page: 227, ja: "並一通りだ・いい加減だ", ex: "事を〔なのめに〕思ひて、心をも入れずありけり。", exja: "物事を【いい加減】に思って、心を入れもしないでいた。", kana: "いいかげん", nu: "打消形で格別の意になる" },
  { no: 244, ko: "おぼろけなり", pos: "形動", page: 228, ja: "並一通りだ・並々ではない", ex: "年ごろの願ひかなひて、この喜び〔おぼろけならず〕。", exja: "長年の願いがかなって、この喜びは【並々ではない】。", kana: "なみなみではない", nu: "多くは打消形で使う" },
  { no: 245, ko: "あやにくなり", pos: "形動", page: 228, ja: "あいにくだ・意地悪だ・はなはだしい", ex: "出で立たむとするに、雨〔あやにくに〕降りけり。", exja: "出発しようとすると、【あいにく】雨が降った。", kana: "あいにく", nu: "現代語「あいにく」の語源" },
  { no: 246, ko: "まめやかなり", pos: "形動", page: 229, ja: "まじめだ・実生活向きだ・本格的だ", ex: "かの人は〔まめやかに〕仕へて、怠ることなし。", exja: "あの人は【まじめ】に仕えて、怠ることがない。", kana: "まじめ" },
  { no: 247, ko: "せちなり", pos: "形動", page: 230, ja: "切実だ・ひたすら", ex: "親を思ふ心の〔せちなる〕ままに、文を書きけり。", exja: "親を思う心が【切実】であるのにまかせて、手紙を書いた。", kana: "せつじつ" },
  { no: 248, ko: "よそなり", pos: "形動", page: 230, ja: "無縁だ・疎遠だ", ex: "世の栄えは我には〔よそなり〕と思ひなしぬ。", exja: "世の中の栄華は私には【無縁】だと思い込んだ。", kana: "むえん" },
  { no: 249, ko: "うちつけなり", pos: "形動", page: 231, ja: "突然だ・軽率だ", ex: "初めて会ふ人に〔うちつけに〕物を問ひけり。", exja: "初めて会う人に【軽率】に物を尋ねた。", kana: "けいそつ" },
  { no: 250, ko: "とみなり", pos: "形動", page: 232, ja: "急だ・突然だ", ex: "夜更けに〔とみなる〕事いできて、馬にて京へのぼりけり。", exja: "夜更けに【急な】用事が起こって、馬で京へ上った。", kana: "きゅうな", nu: "副詞形は「とみに」" },
  { no: 251, ko: "みそかなり", pos: "形動", page: 232, ja: "ひそかだ", ex: "人目を忍びて〔みそかに〕文を書き、使ひに持たせけり。", exja: "人目を忍んで【ひそかに】手紙を書き、使いの者に持たせた。", kana: "ひそかに", nu: "「晦日(みそか)」とは別語" },
  { no: 252, ko: "こまやかなり", pos: "形動", page: 233, ja: "心を込めている・色が濃い・詳しい", ex: "庭の紅葉の色〔こまやかに〕なりて、秋の深きを知りぬ。", exja: "庭の紅葉の色が【濃く】なって、秋が深まったことを知った。", kana: "こく" },
  { no: 253, ko: "らうたげなり", pos: "形動", page: 234, ja: "かわいらしい", ex: "幼き子の〔らうたげなる〕さまを見て、おのづから笑みこぼれぬ。", exja: "幼い子の【かわいらしい】様子を見て、自然と笑みがこぼれた。", kana: "かわいらしい", nu: "「げ」は様子を表す接尾語" },
  { no: 254, ko: "いうなり", kanji: "優なり", pos: "形動", page: 234, ja: "優美だ・優れている", ex: "月清き夜に琴の音〔いうに〕聞こえて、心澄みわたりけり。", exja: "月の清い夜に琴の音が【優美に】聞こえて、心が澄みわたった。", kana: "ゆうびに" },
  { no: 255, ko: "うち", kanji: "内裏", pos: "名", page: 238, ja: "宮中・天皇", ex: "父に伴はれて〔うち〕にまゐり、御前にさぶらひけり。", exja: "父に連れられて【宮中】に参上し、御前にお仕えした。", kana: "きゅうちゅう", nu: "「うへ」と意味が重なる語" },
  { no: 256, ko: "うへ", pos: "名", page: 238, ja: "天皇・奥様", ex: "〔うへ〕の御こころざし深くおはしければ、人みな頼みけり。", exja: "【天皇】のお心遣いが深くていらっしゃったので、人はみな頼りにした。", kana: "てんのう", nu: "文脈で天皇か奥方か判断" },
  { no: 257, ko: "しな", kanji: "品", pos: "名", page: 239, ja: "身分・家柄・品位", ex: "〔しな〕高き家に生まれしかど、心おごらざりけり。", exja: "【身分】の高い家に生まれたけれど、心は驕らなかった。", kana: "みぶん" },
  { no: 258, ko: "ふるさと", pos: "名", page: 240, ja: "古都・なじみのある土地・実家", ex: "母のおはする〔ふるさと〕に帰りて、しばし心を休めけり。", exja: "母のいらっしゃる【実家】に帰って、しばらく心を休めた。", kana: "じっか", nu: "本来は「昔の都」の意味" },
  { no: 259, ko: "こころばへ", pos: "名", page: 241, ja: "心遣い・性格・趣", ex: "この人の〔こころばへ〕なつかしくて、常に語らひけり。", exja: "この人の【性格】が慕わしくて、いつも語り合った。", kana: "せいかく" },
  { no: 260, ko: "ひま", kanji: "隙", pos: "名", page: 242, ja: "すき間・絶え間・機会", ex: "戸の〔ひま〕より月の光さし入りて、床を白く照らせり。", exja: "戸の【すき間】から月の光が差し込んで、床を白く照らしている。", kana: "すきま", nu: "現代語「暇」とは意味が違う" },
  { no: 261, ko: "ひがこと", kanji: "僻事", pos: "名", page: 242, ja: "間違い・道理に外れたこと", ex: "人の言ひしことは〔ひがこと〕なりけりと、後に知りぬ。", exja: "人が言ったことは【間違い】だったと、後になって知った。", kana: "まちがい" },
  { no: 262, ko: "とが", pos: "名", page: 243, ja: "欠点・罪・過失", ex: "人の〔とが〕をのみ言ひて、おのが身を顧みぬはよからず。", exja: "人の【欠点】ばかり言って、自分の身を省みないのはよくない。", kana: "けってん" },
  { no: 263, ko: "そらごと", kanji: "空言・虚言", pos: "名", page: 244, ja: "嘘・偽り", ex: "かやうの話はみな〔そらごと〕にこそあれ、信ずべからず。", exja: "このような話はみな【嘘】であって、信じてはならない。", kana: "うそ" },
  { no: 264, ko: "せうそこ", kanji: "消息", pos: "名", page: 244, ja: "手紙・訪問・様子", ex: "久しく〔せうそこ〕も絶えて、いつしか年の暮れにけり。", exja: "長く【手紙】も途絶えて、いつのまにか年が暮れてしまった。", kana: "てがみ" },
  { no: 265, ko: "くもゐ", kanji: "雲居", pos: "名", page: 245, ja: "宮中・天上・遠く離れた所", ex: "〔くもゐ〕の管絃の声ほのかに聞こえて、夜ふけゆきけり。", exja: "【宮中】の管絃の音がかすかに聞こえて、夜が更けていった。", kana: "きゅうちゅう" },
  { no: 266, ko: "かしこまり", pos: "名", page: 246, ja: "恐縮・お詫び・謹慎", ex: "あやまちを深く悔いて、あるじに〔かしこまり〕を申しけり。", exja: "過ちを深く悔いて、主人に【お詫び】を申し上げた。", kana: "おわび", nu: "恐れ謹む意が中心" },
  { no: 267, ko: "よ", kanji: "世", pos: "名", page: 246, ja: "男女の仲・世の中・治世", ex: "二人の〔よ〕もはかなく絶えて、文のみぞ残りける。", exja: "二人の【男女の仲】もはかなく途絶えて、手紙だけが残った。", kana: "だんじょのなか", nu: "文脈で「世の中」との判別必要", alt: ["よのなか（世の中）"] },
  { no: 268, ko: "かぎり", pos: "名", page: 247, ja: "（人生の）最期・すべて・だけ", ex: "病おもくなりて、今日を〔かぎり〕とぞ思ひける。", exja: "病が重くなって、今日が【最期】だと思った。", kana: "さいご", nu: "「今はかぎり」で死を意味" },
  { no: 269, ko: "ここら", pos: "副", page: 248, ja: "たくさん・たいそう", ex: "〔ここら〕の年を経て、今ぞ古き友に会ひける。", exja: "【たくさん】の年月を経て、今やっと古い友に会った。", kana: "たくさん", nu: "現代語「この辺り」の意ではない", alt: ["そこら"] },
  { no: 270, ko: "かたみに", pos: "副", page: 248, ja: "たがいに", ex: "別れの朝、〔かたみに〕袖をぬらしつつ立ち去りけり。", exja: "別れの朝、【互いに】袖を濡らしながら立ち去った。", kana: "たがいに", nu: "「かたみ(形見)」とは別語" },
  { no: 271, ko: "わざと", pos: "副", page: 249, ja: "わざわざ・特別に・本格的な", ex: "雪深き日に〔わざと〕人の訪ね来たりて、いとうれし。", exja: "雪の深い日に【わざわざ】人が訪ねて来て、たいそう嬉しい。", kana: "わざわざ", nu: "現代語とニュアンスが異なる" },
  { no: 272, ko: "うたて", pos: "副", page: 250, ja: "いやなことに・ますます", ex: "風あらく吹きて、〔うたて〕心細くぞ覚えける。", exja: "風が荒く吹いて、【いやなことに】心細く思われた。", kana: "いやなことに", nu: "「うたてし」(形)と関連語" },
  { no: 273, ko: "かねて", pos: "副", page: 250, ja: "前もって・〜前から", ex: "旅の支度は〔かねて〕よりととのへたれば、騒ぐことなし。", exja: "旅の支度は【前もって】整えておいたので、慌てることはない。", kana: "まえもって", nu: "「かねてより」の形で頻出" },
  { no: 274, ko: "やをら", pos: "副", page: 251, ja: "そっと", ex: "人の寝たるひまに、〔やをら〕戸を開けて出でにけり。", exja: "人が寝ている間に、【そっと】戸を開けて出て行った。", kana: "そっと" },
  { no: 275, ko: "よもすがら", pos: "副", page: 252, ja: "一晩中", ex: "〔よもすがら〕雨の音のみして、つひに眠られざりき。", exja: "【一晩中】雨の音ばかりがして、とうとう眠れなかった。", kana: "ひとばんじゅう", nu: "対義語「ひねもす」は一日中" },
  { no: 276, ko: "ゆめ", pos: "副", page: 252, ja: "まったく〜ない・決して〜（し）てはいけない", ex: "この事、〔ゆめ〕人に語るべからずと固く言ひおきけり。", exja: "この事は【決して】人に語ってはならないと固く言い置いた。", kana: "けっして", nu: "呼応の副詞（下に打消・禁止）", alt: ["ゆめゆめ〜打消・禁止"] },
  { no: 277, ko: "をさをさ", pos: "副", page: 253, ja: "ほとんど〜ない", ex: "山里には訪ひ来る人も〔をさをさ〕なくて、静かなり。", exja: "山里には訪ねて来る人も【ほとんど】なくて、静かだ。", kana: "ほとんど", nu: "呼応の副詞（下に打消を伴う）" },
  { no: 278, ko: "あなかま", pos: "連語", page: 254, ja: "しっ、静かに", ex: "人の聞くに、〔あなかま〕、しばし声な立てそ。", exja: "人が聞いているのだから、【静かに】、しばらく声を立てるな。", kana: "しずかに", nu: "相手を制止する言葉" },
  { no: 279, ko: "かちより", kanji: "徒歩より", pos: "連語", page: 254, ja: "歩いて", ex: "道は遠けれど、車も無くて〔かちより〕まうで来たり。", exja: "道は遠いけれど、車もなくて【歩いて】参上した。", kana: "あるいて", nu: "徒歩であることを強調" },
  { no: 280, ko: "けしからず", pos: "連語", page: 255, ja: "異様だ・普通でない・よくない", ex: "夜更けてこの家のありさまを見るに、〔けしからず〕。", exja: "夜が更けてこの家の様子を見ると、【異様だ】。", kana: "いようだ", nu: "現代語「けしからん」の語源" },
  { no: 281, ko: "おもひやる", pos: "動", page: 260, ja: "想像する・気にかける", ex: "秋の夜、遠き国なる友の心を〔おもひやる〕。", exja: "秋の夜、遠い国にいる友の心を【想像する】。", kana: "そうぞうする" },
  { no: 282, ko: "おきつ", kanji: "掟つ", pos: "動", page: 260, ja: "あらかじめ決める・指図する", ex: "明日の狩りのことを、かねて人々に〔おきつ〕。", exja: "明日の狩りのことを、前もって人々に【指図する】。", kana: "さしずする" },
  { no: 283, ko: "すまふ", kanji: "争ふ・辞ふ", pos: "動", page: 261, ja: "抵抗する・辞退する", ex: "力の限り〔すまへ〕ども、つひに捕へられぬ。", exja: "力の限り【抵抗する】が、ついに捕らえられてしまった。", kana: "ていこうする", nu: "相撲の語源とされる" },
  { no: 284, ko: "さす", kanji: "鎖す", pos: "動", page: 261, ja: "閉める・差す・~しかけてやめる", ex: "日すでに暮れぬれば、人に言ひて門を〔さす〕。", exja: "日が暮れたので、人に言いつけて門を【閉める】。", kana: "しめる", nu: "~しさすは接尾語用法" },
  { no: 285, ko: "しほたる", pos: "動", page: 262, ja: "涙で袖が濡れる", ex: "別れの悲しさに、袖はひたすら〔しほたる〕。", exja: "別れの悲しさに、袖はひたすら【涙で濡れる】。", kana: "なみだでぬれる" },
  { no: 286, ko: "たばかる", pos: "動", page: 262, ja: "工夫する・だます", ex: "敵を討たむとて、夜もすがら〔たばかる〕。", exja: "敵を討とうとして、一晩中【工夫する】。", kana: "くふうする" },
  { no: 287, ko: "まつりごつ", pos: "動", page: 263, ja: "政治を行う", ex: "帝いまだ幼くおはせば、大臣ぞ〔まつりごつ〕。", exja: "帝がまだ幼くていらっしゃるので、大臣が【政治を行う】。", kana: "せいじをおこなう", nu: "「まつりごと」の動詞形" },
  { no: 288, ko: "らうらうじ", pos: "形", page: 264, ja: "物馴れて巧みだ・如才ない", ex: "この姫君、いと〔らうらうじく〕ものし給ふ。", exja: "この姫君は、たいそう【如才ない】さまでいらっしゃる。", kana: "じょさいない", nu: "外見でなく機転・巧みさを表す" },
  { no: 289, ko: "むくつけし", pos: "形", page: 264, ja: "不気味だ・恐ろしい", ex: "夜更けて、山の方より〔むくつけき〕声す。", exja: "夜が更けて、山の方から【不気味な】声がする。", kana: "ぶきみな" },
  { no: 290, ko: "おほけなし", pos: "形", page: 265, ja: "身の程知らずだ・大それている", ex: "身は賤しきに、后を思ひ奉るは〔おほけなし〕。", exja: "身分は低いのに、后をお慕いするのは【身の程知らずだ】。", kana: "みのほどしらずだ", nu: "へりくだる場面でよく使う" },
  { no: 291, ko: "いぶせし", pos: "形", page: 266, ja: "気が晴れない・うっとうしい", ex: "幾日も雨降り続きて、心も〔いぶせく〕おぼゆ。", exja: "何日も雨が降り続いて、心も【気が晴れない】と感じられる。", kana: "きがはれない" },
  { no: 292, ko: "しるし", pos: "形", page: 266, ja: "明白だ・~もそのとおりに", ex: "山の雪の消えぬること、目にも〔しるし〕。", exja: "山の雪が消えたことは、目にも【明白だ】。", kana: "めいはくだ", nu: "名詞の「しるし」とは別語" },
  { no: 293, ko: "こよなし", pos: "形", page: 267, ja: "格段である・格段に劣っている", ex: "この山の眺め、都のそれに〔こよなく〕まさる。", exja: "この山の眺めは、都のそれより【格段に】勝っている。", kana: "かくだんに", nu: "文脈により優劣どちらもある" },
  { no: 294, ko: "くやし", pos: "形", page: 268, ja: "悔やまれる・残念だ", ex: "年月経て、言はでやみにし事の今さら〔くやし〕。", exja: "年月がたって、言わないで終わったことが今さら【悔やまれる】。", kana: "くやまれる" },
  { no: 295, ko: "たのし", pos: "形", page: 268, ja: "裕福だ・豊かだ", ex: "かの家は田も多く、いと〔たのし〕と聞く。", exja: "あの家は田畑も多く、たいそう【裕福だ】と聞く。", kana: "ゆうふくだ", nu: "現代語「楽しい」とは意味が違う" },
  { no: 296, ko: "おもはずなり", pos: "形動", page: 269, ja: "思いがけない・意外だ", ex: "帰る道にて〔おもはずなる〕人に会ひて、驚きぬ。", exja: "帰る道で【思いがけない】人に出会って、驚いた。", kana: "おもいがけない" },
  { no: 297, ko: "ことなり", pos: "形動", page: 269, ja: "違う・別である・格別だ", ex: "昔の都と今の都とは、住む人のさま〔ことなり〕。", exja: "昔の都と今の都とは、住む人のようすが【別である】。", kana: "べつである", nu: "格別だ・特にすぐれている意も" },
  { no: 298, ko: "いろ", pos: "名", page: 270, ja: "情趣・恋愛・容色", ex: "〔いろ〕の道に心を入れて、はかなく年を経にけり。", exja: "【恋愛】の道に心を注いで、むなしく年月を過ごしてしまった。", kana: "れんあい", nu: "恋愛の意で使われることが多い" },
  { no: 299, ko: "こころ", pos: "名", page: 270, ja: "情趣を解する心", ex: "月を見て歌詠む人にこそ、〔こころ〕はあれ。", exja: "月を見て歌を詠む人にこそ、【情趣】を解する心はあるものだ。", kana: "じょうしゅ" },
  { no: 300, ko: "ゆゑ", kanji: "故", pos: "名", page: 271, ja: "理由・品格・風情", ex: "都を出でし〔ゆゑ〕を、人には語らざりけり。", exja: "都を出た【理由】を、人には語らなかった。", kana: "りゆう", nu: "文脈により意味が変わる" },
  { no: 301, ko: "あない", pos: "名", page: 272, ja: "内情・取り次ぎ", ex: "かの家の〔あない〕を、よく知れる者に問ふ。", exja: "あの家の【内情】を、よく知っている者に尋ねる。", kana: "ないじょう", nu: "「案内」の古い読み" },
  { no: 302, ko: "さた", pos: "名", page: 272, ja: "評議・指図・処置", ex: "この所領のことは、後の人々の〔さた〕に任すべし。", exja: "この所領のことは、後の人々の【評議】に任せるのがよい。", kana: "ひょうぎ" },
  { no: 303, ko: "やう", pos: "名", page: 273, ja: "わけ・手段・こと・様子", ex: "人の来たらぬには、さるべき〔やう〕あらむ。", exja: "人が来ないのには、しかるべき【わけ】があるのだろう。", kana: "わけ", nu: "「やうなり」は比況表現" },
  { no: 304, ko: "あらまし", pos: "名", page: 274, ja: "計画・予定・概略", ex: "春の旅の〔あらまし〕を、夜もすがら語りけり。", exja: "春の旅の【計画】を、一晩中語り合った。", kana: "けいかく" },
