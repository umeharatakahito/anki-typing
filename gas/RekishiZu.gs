// 画像そのもの。読み込みが重いので、図表モードに入ったときだけ取りに来る。
const REKISHI_ZU_SRC = {
  islam: 'data:image/jpeg;base64,',
  germanic: 'data:image/png;base64,'
};

// ---------------------------------------------------------------
// 図表の一覧（画像なし。メニューに並べるためだけのもの）
function getRekishiZuList() {
  return REKISHI_ZU.map(z => ({
    id: z.id, title: z.title, note: z.note, count: z.areas.length
  }));
}

// ---------------------------------------------------------------
// 図表ひとつ分。画像と、伏せる場所の一覧を返す。
// opts: { id, shuffle, limit }
function getRekishiZu(opts) {
  opts = opts || {};
  const id = String(opts.id || '');
  const zu = REKISHI_ZU.filter(z => z.id === id)[0];
  if (!zu) return { error: 'その図表は見つかりません' };

  let areas = zu.areas.map((a, i) => {
    const o = {};
    Object.keys(a).forEach(k => { o[k] = a[k]; });
    o.i = i;
    return o;
  });

  if (opts.shuffle) {
    for (let i = areas.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [areas[i], areas[j]] = [areas[j], areas[i]];
    }
  }
  const limit = Number(opts.limit) || 0;
  const order = (limit > 0 ? areas.slice(0, limit) : areas).map(a => a.i);

  return {
    id: zu.id,
    title: zu.title,
    note: zu.note,
    ratio: zu.ratio,
    src: REKISHI_ZU_SRC[zu.id],
    areas: zu.areas,
    order: order
  };
}
