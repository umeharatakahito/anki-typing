// ---------------------------------------------------------------
// 収録範囲（メニューの案内用）
function getRekishiMeta() {
  const prs = REKISHI_WORDS.map(w => w.pr);
  const flds = [];
  REKISHI_WORDS.forEach(w => { if (flds.indexOf(w.fld) < 0) flds.push(w.fld); });
  if (!prs.length) return { total: 0, minPr: 0, maxPr: 0, minNo: 0, maxNo: 0, fields: [] };
  const min = Math.min.apply(null, prs);
  const max = Math.max.apply(null, prs);
  // minNo / maxNo は対戦モードなど、科目共通の画面が見に来る名前
  return { total: REKISHI_WORDS.length, minPr: min, maxPr: max,
           minNo: min, maxNo: max, unit: 'プリント番号', fields: flds };
}

// ---------------------------------------------------------------
// 出題データの取り出し
// opts: { from, to, limit, shuffle, fld, source }
// from / to はプリント番号（20〜26）で指定する。
function getRekishiWords(opts) {
  opts = opts || {};
  const from  = Number(opts.from) || 0;
  const to    = Number(opts.to)   || 0;
  const limit = Number(opts.limit) || 20;
  const fld   = opts.fld || 'all';

  // 苦手な語だけから出すときは、範囲や分野より苦手リストを優先する
  const weak = (opts.source === 'weak') ? weakKeys_('rekishi') : null;

  let words = REKISHI_WORDS.filter(w =>
    (!from || w.pr >= from) &&
    (!to   || w.pr <= to) &&
    (fld === 'all' || w.fld === fld) &&
    (!weak || weak[w.a] !== undefined)
  );

  const matched = words.length;

  if (opts.shuffle) {
    words = words.slice();
    for (let i = words.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [words[i], words[j]] = [words[j], words[i]];
    }
  } else if (weak) {
    // 苦手な語は、取りこぼした回数が多いものから
    words = words.slice().sort((a, b) => weak[b.a] - weak[a.a]);
  } else {
    words = words.slice().sort((a, b) => a.no - b.no);
  }

  return { words: words.slice(0, limit).map(decorate_), matched: matched };
}

// 対戦モードや記録は英単語・古文と同じ形の語オブジェクトを見に行くので、
// 出すときに ko（答え）・ja（問題文）の別名を添えておく。
function decorate_(w) {
  const o = {};
  Object.keys(w).forEach(k => { o[k] = w[k]; });
  o.ko = w.a;
  o.ja = w.q;
  return o;
}
