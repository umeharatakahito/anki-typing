  { no: 1709, en: "appoint", ja: "〜を任命する／（日時）を指定する／〜を指名する", nu: "受け身でよく使う", kana: "にんめいする", ex: "The school appointed her as the new team captain.", exja: "学校は彼女を新しいチームの主将に【任命し】た。" },
  { no: 1709, type: "idiom", en: "appoint A as B", ja: "AをBに任命する／AをBに指名する", nu: "かたい語／公式な任命に使う", kana: "にんめいする", ex: "They appointed her as the new leader of the group.", exja: "彼らは彼女をそのグループの新しいリーダーに【任命した】。" },
  { no: 1711, en: "regard", ja: "〜をみなす／〜を評価する／〜を尊重する", nu: "as を伴う形が基本", kana: "みなす", ex: "Many people regard him as a great scientist.", exja: "多くの人は彼を偉大な科学者だと【みなし】ている。" },
