  { no: 1712, type: "idiom", en: "incorporate A into B", ja: "AをBに取り入れる／AをBに組み込む", nu: "into と結びつく", kana: "とりいれる", ex: "The cook incorporated local fish into his new menu.", exja: "料理人は地元の魚を新しい献立に【取り入れた】。" },
