  { no: 1729, type: "idiom", en: "as long as", ja: "…する限りは／…しさえすれば／…する間は", nu: "条件を表す／時間の長さにも", kana: "かぎりは", ex: "You may stay here as long as you keep quiet.", exja: "静かにしている【限りは】ここにいてよい。" },
