  { no: 1714, type: "idiom", en: "confine A to B", ja: "AをBに閉じ込める／AをBに限る／AをBに制限する", nu: "to で範囲を限る", kana: "とじこめる", ex: "The heavy snow confined us to the house for three days.", exja: "大雪は三日間、私たちを家に【閉じ込めた】。" },
