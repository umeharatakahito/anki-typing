  { no: 1711, type: "idiom", en: "regard A as B", ja: "AをBと考えている／AをBとみなす", nu: "この形が最も一般的", kana: "かんがえている", ex: "Many people regard him as the best player in Japan.", exja: "多くの人が彼を日本最高の選手だと【考えている】。" },
