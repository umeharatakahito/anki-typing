  { no: 1717, en: "keen", ja: "熱心な／鋭い／強い／切実な", nu: "主にイギリス英語", kana: "ねっしんな", ex: "She is a keen student of ocean animals.", exja: "彼女は海の動物を学ぶ【熱心な】生徒だ。" },
