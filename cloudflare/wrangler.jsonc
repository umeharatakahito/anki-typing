{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anki-typing",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // 暗記タイピングの画像（scripts/fetch-images.mjs で取ってくる）
  "assets": { "directory": "public" },
  "vars": {
    // Google ログインの OAuth クライアント ID（公開されてよい値）。承認済みの生成元は
    // https://anki-typing.takahito-ume.workers.dev と http://localhost:8791
    "GOOGLE_CLIENT_ID": "1001255742442-pmd3a71i42mnrqvunrj0fr762uevoi79.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anki-typing",
      // `npx wrangler d1 create anki-typing` で表示された ID に置き換える
      "database_id": "3e1785ac-e860-42ba-bc18-4697e3a63e9d",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "VERSUS", "class_name": "VersusHub" },
      // タイピングの対戦（WebSocket）。部屋ごとと、自動マッチの待合室
      { "name": "TYPING_VS", "class_name": "TypingVersus" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VersusHub"] },
    { "tag": "v2", "new_sqlite_classes": ["TypingVersus"] }
  ]
}
