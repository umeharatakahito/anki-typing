{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anki-typing",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // 暗記タイピングの画像（scripts/fetch-images.mjs で取ってくる）
  "assets": { "directory": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anki-typing",
      // `npx wrangler d1 create anki-typing` で表示された ID に置き換える
      "database_id": "3e1785ac-e860-42ba-bc18-4697e3a63e9d",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VERSUS", "class_name": "VersusHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VersusHub"] }]
}
